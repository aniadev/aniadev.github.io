# dotenv environment variable files — pattern không-slash nên tự phủ MỌI cấp thư mục,
# gồm cả heads/<headId>/.env per-head (AD-13); .env.example (mọi cấp) giữ commit
.env
.env.*
!.env.example
.env.development.local
.env.test.local
.env.production.local
.env.local

# operator / deploy signing keys — never commit (supply via out-of-repo path, S2.2 AC3)
*.skey
deploy-*.sk

